#!/bin/sh

[ -e /etc/config/ubootenv ] && exit 0

touch /etc/config/ubootenv

. /lib/uboot-envtools.sh
. /lib/functions.sh

board=$(board_name)
case "$board" in
	cmcc,rax3000q|\
	redmi,ax3000|\
	xiaomi,cr881x)
		dev=$(find_mtd_part 0:appsblenv)
		[ -n "$dev" ] || dev=$(find_mtd_part 0:APPSBLENV)
		[ -n "$dev" ] || dev="/dev/mtd10"
		ubootenv_add_uci_config "$dev" "0x0" "0x10000" "0x20000"
		;;
esac

config_load ubootenv
config_foreach ubootenv_add_app_config ubootenv

exit 0
